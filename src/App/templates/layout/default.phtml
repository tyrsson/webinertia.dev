<?php

declare(strict_types=1);

use Axleus\Message\MessageLevel;

$this->headMeta()
    ->setCharSet('UTF-8')
    ->appendName('viewport', 'width=device-width, initial-scale=1')
    ->appendName('color-scheme', 'light dark');

$this->headLink(
    [
        'rel'  => 'icon',
        'type' => 'image/svg+xml',
        'href' => $this->basePath('favicon.svg'),
    ]
);

// styles
$this->headLink()
    ->prependStylesheet($this->basePath('assets/css/style.css'))
    ->prependStylesheet('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700;800&display=swap')
    ->prepend([
        'crossorigin' => '',
        'href'        => 'https://fonts.gstatic.com',
        'rel'        => 'preconnect',
    ])
    ->prepend([
        'rel'  => 'preconnect',
        'href' => 'https://fonts.googleapis.com',
    ])
    ->prependStylesheet('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css');

// head script files and script
$this->headScript()
    ->appendFile(
        'https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js',
        [
            'type'        => 'text/javascript',
            'integrity'   => 'sha384-/TgkGk7p307TH7EXJDuUlgG3Ce1UVolAOFopFekQkkXihi5u/6OCvVKyz1W+idaz',
            'crossorigin' => 'anonymous',
        ],
    );

$this->inlineScript()
    ->prependFile('https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js');
?>

<?= $this->doctype(); ?>

<html lang="en-US" data-theme="dark">
    <head>
        <base href="<?= $this->basePath('/'); ?>" />
        <?= $this->headTitle('Webinertia')->setSeparator(' | ') ?>
        <?= $this->headMeta() ?>
        <?= $this->headLink() ?>
        <?= $this->headScript() ?>
    </head>
    <body hx-boost="true" hx-push-url="true">
        <?= $this->body ?>
    </body>
    <?= $this->inlineScript() ?>

    <!-- Menu Script -->
    <script>
        // Set .active on the matching side-nav link; never touches mobile nav links
        function setActiveNav() {
            const currentPath = window.location.pathname;
            document.querySelectorAll('#side-nav .side-nav-items .side-nav-item a').forEach(function(link) {
                link.classList.toggle('active', link.pathname === currentPath);
            });
        }

        function initPage() {
            setActiveNav();
        }

        document.addEventListener('DOMContentLoaded', initPage);

        // Re-init after every HTMX content swap (boosted navigation).
        document.addEventListener('htmx:afterSettle', initPage);

        // Re-init when HTMX restores a page from the history cache (back/forward).
        document.addEventListener('htmx:historyRestore', initPage);

        (function () {
            let tracyEl = null;

            document.addEventListener('htmx:beforeSwap', function () {
                tracyEl = document.getElementById('tracy-debug');
                if (tracyEl) {
                    tracyEl.remove(); // detach before HTMX replaces body innerHTML
                }
            });

            // Use htmx:afterSwap (not afterSettle) to re-attach as early as possible,
            // before Tracy's async _tracy_bar script can fire and call loadAjax().
            document.addEventListener('htmx:afterSwap', function () {
                if (tracyEl) {
                    document.body.appendChild(tracyEl);
                    tracyEl = null;
                }
            });
        })();
    </script>
</html>