<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Components | Webinertia</title>
    <meta name="description" content="UI component library — modals and interactive patterns.">

    <!-- Bootstrap 5.3 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700;800&display=swap" rel="stylesheet">

    <!-- Custom Styles -->
    <link rel="stylesheet" href="assets/css/style.css">
</head>
<body>

    <!-- Side Navigation -->
    <nav class="side-nav">
        <div class="side-nav-logo">Webinertia</div>
        <ul class="side-nav-items">
            <li class="side-nav-item"><a href="index.html" data-label="Home">🏠</a></li>
            <li class="side-nav-item"><a href="services.html" data-label="Services">⚡</a></li>
            <li class="side-nav-item"><a href="about.html" data-label="About">💡</a></li>
            <li class="side-nav-item"><a href="portfolio.html" data-label="Portfolio">🎨</a></li>
            <li class="side-nav-item"><a href="contact.html" data-label="Contact">📧</a></li>
            <li class="side-nav-item"><a href="components.html" data-label="Components">🧩</a></li>
        </ul>
    </nav>

    <!-- Mobile Navigation Toggle (visible ≤1024px) -->
    <button class="mobile-nav-toggle"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#mobileNav"
            aria-controls="mobileNav"
            aria-label="Open navigation">
        <span></span>
    </button>

    <!-- Main Content -->
    <main class="main-content">

        <!-- Page Header -->
        <section class="page-header">
            <h1 class="hero-title">
                <span class="gradient-text">Components</span>
            </h1>
            <div class="divider"></div>
            <p class="hero-subtitle">
                Interactive UI patterns built with Bootstrap 5.3 and styled to match the Webinertia design language
            </p>
        </section>

        <!-- ============================================================
             SECTION 1 — Basic Modals
             ============================================================ -->
        <section class="component-section">
            <div class="section-header">
                <h2 class="section-title"><span class="gradient-text">Basic Modals</span></h2>
                <div class="divider"></div>
                <p class="section-subtitle">Standard modal patterns with themed accent colours</p>
            </div>

            <div class="modal-trigger-grid">

                <!-- Default / Purple -->
                <div class="modal-trigger-card">
                    <div class="card-icon">🟣</div>
                    <h3>Default Modal</h3>
                    <p>A general-purpose modal with a purple gradient accent bar, glassmorphic content panel, and styled action buttons.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-primary" data-bs-toggle="modal" data-bs-target="#modalDefault">
                            Open Modal
                        </button>
                    </div>
                </div>

                <!-- Cyan -->
                <div class="modal-trigger-card trigger-cyan">
                    <div class="card-icon">🔵</div>
                    <h3>Cyan Modal</h3>
                    <p>Uses the cyan-to-purple gradient accent. Useful for informational or discovery-oriented dialogs.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-cyan" data-bs-toggle="modal" data-bs-target="#modalCyan">
                            Open Modal
                        </button>
                    </div>
                </div>

                <!-- Success -->
                <div class="modal-trigger-card trigger-success">
                    <div class="card-icon">✅</div>
                    <h3>Success Modal</h3>
                    <p>Confirmation pattern — centred icon layout, green accent bar, and a single primary action.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-success" data-bs-toggle="modal" data-bs-target="#modalSuccess">
                            Open Modal
                        </button>
                    </div>
                </div>

                <!-- Danger / Destructive -->
                <div class="modal-trigger-card trigger-danger">
                    <div class="card-icon">⚠️</div>
                    <h3>Danger Modal</h3>
                    <p>Destructive-action confirmation dialog — red accent, bold warning copy, cancel / confirm pattern.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-danger" data-bs-toggle="modal" data-bs-target="#modalDanger">
                            Open Modal
                        </button>
                    </div>
                </div>

            </div>
        </section>

        <!-- ============================================================
             SECTION 2 — Form & Scrollable Modals
             ============================================================ -->
        <section class="diagonal-section">
            <div class="section-header">
                <h2 class="section-title"><span class="gradient-text">Form &amp; Scrollable</span></h2>
                <div class="divider"></div>
                <p class="section-subtitle">Data-entry dialogs and long-content patterns</p>
            </div>

            <div class="modal-trigger-grid">

                <!-- Form / Contact -->
                <div class="modal-trigger-card">
                    <div class="card-icon">📋</div>
                    <h3>Form Modal</h3>
                    <p>Embedded contact / lead-capture form inside a modal. Inputs inherit the site's glass-dark form styles.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-primary" data-bs-toggle="modal" data-bs-target="#modalForm">
                            Open Form
                        </button>
                    </div>
                </div>

                <!-- Scrollable long-content -->
                <div class="modal-trigger-card">
                    <div class="card-icon">📜</div>
                    <h3>Scrollable Modal</h3>
                    <p>A modal with a fixed-height, scrollable body — ideal for terms of service, privacy policies, or changelog content.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-primary" data-bs-toggle="modal" data-bs-target="#modalScrollable">
                            Open Modal
                        </button>
                    </div>
                </div>

                <!-- Large / Fullscreen -->
                <div class="modal-trigger-card">
                    <div class="card-icon">🖥️</div>
                    <h3>Large Modal</h3>
                    <p>Bootstrap's <code class="code-tag cyan">modal-lg</code> size — suitable for data tables, image galleries, or multi-step wizards.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-primary" data-bs-toggle="modal" data-bs-target="#modalLarge">
                            Open Modal
                        </button>
                    </div>
                </div>

                <!-- Centered vertically -->
                <div class="modal-trigger-card">
                    <div class="card-icon">🎯</div>
                    <h3>Centred Modal</h3>
                    <p>Vertically and horizontally centred in the viewport using Bootstrap's <code class="code-tag cyan">modal-dialog-centered</code> class.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-primary" data-bs-toggle="modal" data-bs-target="#modalCentered">
                            Open Modal
                        </button>
                    </div>
                </div>

            </div>
        </section>

        <!-- ============================================================
             SECTION 3 — Toasts
             ============================================================ -->
        <section class="component-section">
            <div class="section-header">
                <h2 class="section-title"><span class="gradient-text">Toasts</span></h2>
                <div class="divider"></div>
                <p class="section-subtitle">Non-blocking notifications that auto-dismiss or persist until dismissed</p>
            </div>

            <div class="toast-demo-grid">

                <!-- Default / Purple -->
                <div class="modal-trigger-card">
                    <div class="card-icon">🟣</div>
                    <h3>Default Toast</h3>
                    <p>Purple gradient accent bar — the base notification style. Auto-dismisses after 4 seconds.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-primary" onclick="showToast('toastDefault')">Show Toast</button>
                    </div>
                </div>

                <!-- Cyan -->
                <div class="modal-trigger-card trigger-cyan">
                    <div class="card-icon">🔵</div>
                    <h3>Cyan Toast</h3>
                    <p>Cyan accent — suitable for informational updates, tips, or new-feature announcements.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-cyan" onclick="showToast('toastCyan')">Show Toast</button>
                    </div>
                </div>

                <!-- Success -->
                <div class="modal-trigger-card trigger-success">
                    <div class="card-icon">✅</div>
                    <h3>Success Toast</h3>
                    <p>Green accent — confirms a completed action such as saving, submitting, or sending.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-success" onclick="showToast('toastSuccess')">Show Toast</button>
                    </div>
                </div>

                <!-- Danger -->
                <div class="modal-trigger-card trigger-danger">
                    <div class="card-icon">🔴</div>
                    <h3>Danger Toast</h3>
                    <p>Red accent — flags errors, failed operations, or destructive outcomes that need attention.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-danger" onclick="showToast('toastDanger')">Show Toast</button>
                    </div>
                </div>

                <!-- Warning -->
                <div class="modal-trigger-card trigger-warning">
                    <div class="card-icon">⚠️</div>
                    <h3>Warning Toast</h3>
                    <p>Yellow-magenta accent — non-critical warnings or cautionary notices that don't block the user.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-warning" onclick="showToast('toastWarning')">Show Toast</button>
                    </div>
                </div>

                <!-- Simple / no header -->
                <div class="modal-trigger-card">
                    <div class="card-icon">💬</div>
                    <h3>Simple Toast</h3>
                    <p>Header-less, compact toast — just an icon and a short message. Great for quick inline feedback.</p>
                    <div class="trigger-card-footer">
                        <button class="btn-sm-primary" onclick="showToast('toastSimple')">Show Toast</button>
                    </div>
                </div>

            </div>
        </section>

        <!-- ============================================================
             SECTION 4 — Tooltips
             ============================================================ -->
        <section class="component-section">
            <div class="section-header">
                <h2 class="section-title"><span class="gradient-text">Tooltips</span></h2>
                <div class="divider"></div>
                <p class="section-subtitle">Hover any element below — four placement directions and four accent variants</p>
            </div>

            <!-- Placement row -->
            <div class="section-header tooltip-group-header">
                <p class="tooltip-demo-label">Placements</p>
            </div>
            <div class="tooltip-demo-strip">
                <button class="btn-sm-primary"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    title="Tooltip on top">Top</button>

                <button class="btn-sm-primary"
                    data-bs-toggle="tooltip"
                    data-bs-placement="bottom"
                    title="Tooltip on bottom">Bottom</button>

                <button class="btn-sm-primary"
                    data-bs-toggle="tooltip"
                    data-bs-placement="start"
                    title="Tooltip on the left">Left</button>

                <button class="btn-sm-primary"
                    data-bs-toggle="tooltip"
                    data-bs-placement="end"
                    title="Tooltip on the right">Right</button>
            </div>

            <!-- Variant row -->
            <div class="section-header tooltip-group-header">
                <p class="tooltip-demo-label">Accent variants</p>
            </div>
            <div class="tooltip-demo-strip">
                <button class="btn-sm-primary"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    data-bs-custom-class="tooltip-purple"
                    title="Default purple accent — general usage">🟣 Purple</button>

                <button class="btn-sm-cyan"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    data-bs-custom-class="tooltip-cyan"
                    title="Cyan accent — informational hints &amp; feature tips">🔵 Cyan</button>

                <button class="btn-sm-success"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    data-bs-custom-class="tooltip-success"
                    title="Success accent — validation feedback &amp; confirmations">✅ Success</button>

                <button class="btn-sm-danger"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    data-bs-custom-class="tooltip-danger"
                    title="Danger accent — warnings &amp; destructive actions">🔴 Danger</button>
            </div>

            <!-- Rich HTML tooltip -->
            <div class="section-header tooltip-group-header">
                <p class="tooltip-demo-label">HTML tooltip</p>
            </div>
            <div class="tooltip-demo-strip">
                <button class="btn-sm-primary"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    data-bs-html="true"
                    title="&lt;strong&gt;Space Grotesk&lt;/strong&gt;&lt;br&gt;Tooltips support &lt;em&gt;HTML content&lt;/em&gt; via &lt;code&gt;data-bs-html=&quot;true&quot;&lt;/code&gt;">
                    HTML Tooltip
                </button>

                <span class="tech-pill"
                    data-bs-toggle="tooltip"
                    data-bs-placement="top"
                    data-bs-custom-class="tooltip-cyan"
                    title="Works on any element, not just buttons">
                    Hover a pill
                </span>

                <span class="tooltip-term"
                    data-bs-toggle="tooltip"
                    data-bs-placement="bottom"
                    title="Inline text can carry a tooltip too">
                    Hover underlined text
                </span>
            </div>
        </section>

        <!-- ============================================================
             SECTION 5 — Accordions
             ============================================================ -->
        <section class="diagonal-section">
            <div class="section-header">
                <h2 class="section-title"><span class="gradient-text">Accordions</span></h2>
                <div class="divider"></div>
                <p class="section-subtitle">Collapsible content panels — standard and flush variants</p>
            </div>

            <div class="accordion-demo-grid">

                <!-- Standard accordion -->
                <div>
                    <p class="accordion-demo-label">Standard</p>
                    <div class="accordion" id="accordionStandard">

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseOne"
                                    aria-expanded="true"
                                    aria-controls="collapseOne">
                                    🚀 What technologies do you specialise in?
                                </button>
                            </h2>
                            <div id="collapseOne" class="accordion-collapse collapse show"
                                data-bs-parent="#accordionStandard">
                                <div class="accordion-body">
                                    We specialise in modern PHP frameworks (Laminas, Mezzio, Slim), server-side rendering with HTMX, and cloud-native infrastructure on AWS. Our stack is chosen for longevity, performance, and security.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseTwo"
                                    aria-expanded="false"
                                    aria-controls="collapseTwo">
                                    ⚡ How long does a typical project take?
                                </button>
                            </h2>
                            <div id="collapseTwo" class="accordion-collapse collapse"
                                data-bs-parent="#accordionStandard">
                                <div class="accordion-body">
                                    Scope dictates timeline. A focused web application typically ships in 8 – 16 weeks — from discovery through design,  development, and launch. We share a detailed roadmap after our initial consultation.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseThree"
                                    aria-expanded="false"
                                    aria-controls="collapseThree">
                                    🔐 How do you handle security?
                                </button>
                            </h2>
                            <div id="collapseThree" class="accordion-collapse collapse"
                                data-bs-parent="#accordionStandard">
                                <div class="accordion-body">
                                    Security is built in, not bolted on. We follow OWASP guidelines, conduct regular penetration tests, enforce least-privilege access controls, and monitor all production systems around the clock.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#collapseFour"
                                    aria-expanded="false"
                                    aria-controls="collapseFour">
                                    🌍 Do you work with international clients?
                                </button>
                            </h2>
                            <div id="collapseFour" class="accordion-collapse collapse"
                                data-bs-parent="#accordionStandard">
                                <div class="accordion-body">
                                    Absolutely. We're a remote-first team and serve clients across North America, Europe, and the Asia-Pacific region. We adapt to your timezone and preferred communication tools.
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Flush accordion (always-open, no parent binding) -->
                <div>
                    <p class="accordion-demo-label">Flush (multi-open)</p>
                    <div class="accordion accordion-flush" id="accordionFlush">

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#flushOne"
                                    aria-expanded="false"
                                    aria-controls="flushOne">
                                    💡 Discovery &amp; Strategy
                                </button>
                            </h2>
                            <div id="flushOne" class="accordion-collapse collapse">
                                <div class="accordion-body">
                                    We begin every engagement with a structured discovery phase — stakeholder interviews, technical audits, and competitive analysis — to ensure the solution we build is the one you actually need.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#flushTwo"
                                    aria-expanded="false"
                                    aria-controls="flushTwo">
                                    🎨 Design &amp; Prototyping
                                </button>
                            </h2>
                            <div id="flushTwo" class="accordion-collapse collapse">
                                <div class="accordion-body">
                                    High-fidelity Figma prototypes are shared for review before a single line of code is written. We iterate fast on design, refining layouts, interactions, and visual identity until you're delighted.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#flushThree"
                                    aria-expanded="false"
                                    aria-controls="flushThree">
                                    🔧 Build &amp; QA
                                </button>
                            </h2>
                            <div id="flushThree" class="accordion-collapse collapse">
                                <div class="accordion-body">
                                    Two-week sprints keep delivery predictable. Every sprint closes with a demo, a round of automated and manual QA, and updated documentation. No surprises at launch.
                                </div>
                            </div>
                        </div>

                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#flushFour"
                                    aria-expanded="false"
                                    aria-controls="flushFour">
                                    ☁️ Deploy &amp; Support
                                </button>
                            </h2>
                            <div id="flushFour" class="accordion-collapse collapse">
                                <div class="accordion-body">
                                    Zero-downtime deployments via CI/CD pipelines, blue-green environments on AWS, and 24/7 monitoring. Post-launch we offer tiered support packages — from basic SLA cover to a dedicated engineering team.
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </section>

        <!-- ============================================================
             CTA
             ============================================================ -->
        <section class="cta-section">
            <h2 class="section-title">
                <span class="gradient-text">More Components Coming</span>
            </h2>
            <p class="section-subtitle">
                Offcanvas panels, popovers, tabs, badges, and more — all themed to match the Webinertia design system
            </p>
            <div class="cta-buttons">
                <a href="contact.html" class="btn-primary">Request a Component</a>
                <a href="index.html" class="btn-outline">Back to Home</a>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer>
        <div class="footer-content">
            <p>© 2026 <span class="footer-brand">Webinertia</span> <span class="accent-dot"></span> Shaping Digital Futures</p>
        </div>
    </footer>


    <!-- ================================================================
         MODALS
         ================================================================ -->

    <!-- 1. Default / Purple Modal -->
    <div class="modal fade" id="modalDefault" tabindex="-1" aria-labelledby="modalDefaultLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalDefaultLabel">Default Modal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>
                        This is the default modal variant using the <strong class="fg-purple">purple gradient</strong> accent bar. It inherits the site's dark glassmorphic aesthetic with a backdrop blur and a subtle purple border glow.
                    </p>
                    <p>
                        Use this pattern for general information dialogs, detail panels, or any non-critical interaction where a standard modal flow is appropriate.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-ghost" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn-sm-primary" data-bs-dismiss="modal">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Cyan Modal -->
    <div class="modal fade modal-cyan" id="modalCyan" tabindex="-1" aria-labelledby="modalCyanLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalCyanLabel">Cyan Modal</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>
                        The cyan variant uses the <strong class="fg-cyan">cyan-to-purple gradient</strong> accent bar and a cyan-tinted border glow. This works well for informational, discovery, or onboarding dialogs — anything that feels exploratory rather than critical.
                    </p>
                    <p>
                        Switch between variants by adding a modifier class — <code class="code-tag cyan">modal-cyan</code>, <code class="code-tag magenta">modal-magenta</code>, <code class="code-tag danger">modal-danger</code>, or <code class="code-tag success">modal-success</code> — to the <code class="code-tag muted">.modal</code> element.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-ghost" data-bs-dismiss="modal">Dismiss</button>
                    <button type="button" class="btn-sm-cyan" data-bs-dismiss="modal">Got it</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Success Modal (icon-centred) -->
    <div class="modal fade modal-success" id="modalSuccess" tabindex="-1" aria-labelledby="modalSuccessLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-icon-header border-0">
                    <div class="modal-icon-circle success">✅</div>
                    <h5 class="modal-title text-center" id="modalSuccessLabel">Action Successful</h5>
                </div>
                <div class="modal-body text-center">
                    <p>
                        Your project has been submitted and our team has been notified. We'll review your request and reach out within <strong class="fg-success">24 hours</strong>.
                    </p>
                    <p>
                        You'll receive a confirmation email at the address provided.
                    </p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-sm-success" data-bs-dismiss="modal">Awesome, thanks!</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Danger / Destructive Modal -->
    <div class="modal fade modal-danger" id="modalDanger" tabindex="-1" aria-labelledby="modalDangerLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header modal-icon-header border-0">
                    <div class="modal-icon-circle danger">⚠️</div>
                    <h5 class="modal-title text-center" id="modalDangerLabel">Delete Project?</h5>
                </div>
                <div class="modal-body text-center">
                    <p>
                        This action <strong class="fg-danger">cannot be undone</strong>. All associated files, settings, and history for this project will be permanently removed from our servers.
                    </p>
                    <p>
                        Are you sure you want to continue?
                    </p>
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn-ghost" data-bs-dismiss="modal">No, keep it</button>
                    <button type="button" class="btn-sm-danger" data-bs-dismiss="modal">Yes, delete</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. Form Modal -->
